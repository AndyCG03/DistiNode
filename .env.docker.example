# Copia este archivo a .env (junto a docker-compose.yml) y rellénalo. Ver README → "Docker".
# Genera secretos con:  openssl rand -base64 32

# ── Dirección pública ───────────────────────────────────────────
# URL con la que la gente abre la app (sin barra final). Debe coincidir con SITE_ADDRESS.
PUBLIC_URL=http://localhost
# ":80" = HTTP en cualquier host. Con un dominio que apunte a este servidor (p. ej. distinode.midominio.cu),
# pon aquí el dominio y PUBLIC_URL=https://distinode.midominio.cu: Caddy gestiona el certificado HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── Sesiones ────────────────────────────────────────────────────
BETTER_AUTH_SECRET=

# ── Correo (enlace mágico) ──────────────────────────────────────
# Vacío = Mailpit (los correos se ven en http://localhost:8025; no salen a internet).
# Producción: smtp://usuario:clave@smtp.tuproveedor.com:587
SMTP_URL=
MAIL_FROM=DistiNode <no-responder@distinode.local>
MAILPIT_PORT=8025

# ── Google (opcional) ───────────────────────────────────────────
# Redirect URI autorizada en Google Cloud: ${PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Tiempo real (opcional) ──────────────────────────────────────
# Vacío = servidor de Liveblocks propio (contenedor "liveblocks").
# Para la nube de Liveblocks: LIVEBLOCKS_SECRET_KEY=sk_… y LIVEBLOCKS_BASE_URL= (vacío, no comentado).
LIVEBLOCKS_SECRET_KEY=
