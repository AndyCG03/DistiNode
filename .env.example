# Desarrollo sin Docker (npm run dev). Copia a .env.local. Para Docker usa .env.docker.example.

# Postgres: rol de la app (sin superusuario) y, para migrar, el dueño de las tablas.
DATABASE_URL=postgres://distinode_app:CLAVE@localhost:5432/distinode
MIGRATION_DATABASE_URL=postgres://distinode:CLAVE@localhost:5432/distinode

# Sesiones (openssl rand -base64 32) y URL pública
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Correo del enlace mágico
SMTP_URL=smtp://localhost:1025
MAIL_FROM=DistiNode <no-responder@distinode.local>

# Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Liveblocks: servidor local (npx liveblocks dev) o la nube (sk_… y sin LIVEBLOCKS_BASE_URL)
LIVEBLOCKS_SECRET_KEY=sk_localdev
LIVEBLOCKS_BASE_URL=http://localhost:1153
LIVEBLOCKS_PUBLIC_URL=http://localhost:1153
