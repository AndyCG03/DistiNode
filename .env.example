# Copia este archivo a .env.local y rellena cada valor. Ver README → "Claves".

# Supabase → Project Settings → API (o "Connect"): URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys: clave publicable (sb_publishable_…) o la "anon" heredada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Liveblocks → tu proyecto → API keys: clave secreta (sk_…). Solo servidor, nunca NEXT_PUBLIC.
LIVEBLOCKS_SECRET_KEY=
